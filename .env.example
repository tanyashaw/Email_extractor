# =============================================================================
# Email Extractor Backend — Environment Configuration Example
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# The application works without a .env file; these are the defaults baked in.
# =============================================================================

# ---------------------------------------------------------------------------
# CORS — allowed frontend origins (comma-separated)
# ---------------------------------------------------------------------------
# Set this to the URL your React / frontend dev server runs on.
# Multiple origins: ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Scraper behaviour
# ---------------------------------------------------------------------------

# Seconds to wait before a page request is considered timed out.
REQUEST_TIMEOUT=10

# Maximum number of URLs accepted in a single POST /api/scraper/extract call.
# Keep this low (2–5) for demo purposes; increase cautiously for production.
MAX_URLS_PER_BATCH=3

# Minimum pause (in seconds) between consecutive HTTP requests.
# Increase for politer crawling; 1.0 s is a conservative default.
DELAY_BETWEEN_REQUESTS=1.0
